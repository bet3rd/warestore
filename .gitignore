__pycache__/
.pytest_cache/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
# Ignore PyInstaller-generated specs, but keep the hand-written build spec
# (build.bat / the release workflow build from it).
*.spec
!warestore.spec
.python-version.bak
*.log
.env
.env.*
