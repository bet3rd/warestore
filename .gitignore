# Per-machine HWID profile store (runtime data, not source)
profiles.json
# Fetched at runtime from remote — not bundled in dist
hardware_pool.json

# Abandoned Rust rewrite (preserved on rust-rewrite branch)
warestore-rs/

# Plaintext token exports — never commit (live refresh tokens)
tokens.txt

# Spoofer injector — downloaded to %APPDATA% at runtime, never source
injector.exe
