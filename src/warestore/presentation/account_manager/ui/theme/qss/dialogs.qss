QDialog#warestore_dialog {
    background: #141414;
}
QDialog#warestore_dialog QLabel#info {
    color: #8a8a8a;
    font-size: 12px;
}
QDialog#warestore_dialog QLabel#dialog_title {
    color: #e8e8e8;
    font-size: 13px;
    font-weight: 600;
}
QDialog#warestore_dialog QLabel#field_label {
    color: #909090;
    font-size: 11px;
}
QDialog#warestore_dialog QLabel#unit_label {
    color: #686868;
    font-size: 10px;
}
QComboBox {
    background: #1e1e1e;
    color: #e0e0e0;
    border: 1px solid #2a2a2a;
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 12px;
    min-height: 20px;
}
QComboBox:hover { border: 1px solid #383838; }
QComboBox:focus { border: 1px solid #880808; }
QComboBox::drop-down {
    border: none;
    width: 26px;
}
QComboBox::down-arrow {
    width: 10px;
    height: 10px;
}
QComboBox QAbstractItemView {
    background: #1e1e1e;
    color: #e0e0e0;
    border: 1px solid #2e2e2e;
    selection-background-color: #880808;
    outline: none;
}
QDoubleSpinBox, QSpinBox {
    background: #1e1e1e;
    color: #e0e0e0;
    border: 1px solid #2a2a2a;
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 12px;
    min-height: 20px;
}
QDoubleSpinBox:hover, QSpinBox:hover { border: 1px solid #383838; }
QDoubleSpinBox:focus, QSpinBox:focus { border: 1px solid #880808; }
QPushButton#dialog_btn {
    min-height: 0;
    padding: 0;
    font-size: 12px;
}

/* Native dialogs (QMessageBox / QInputDialog) aren't tagged #warestore_dialog,
   so they'd inherit Fusion's light background without these rules. */
QMessageBox, QInputDialog {
    background: #141414;
}
QMessageBox QLabel, QInputDialog QLabel {
    color: #d0d0d0;
    background: transparent;
    font-size: 12px;
}
/* Standardize dialog button geometry: fixed vertical rhythm, symmetric
   horizontal padding, and a min-width so the button box can't squish them. */
QMessageBox QPushButton, QInputDialog QPushButton {
    min-width: 88px;
    min-height: 30px;
    padding: 7px 18px;
}

QToolTip {
    background: #1e1e1e;
    color: #e0e0e0;
    border: 1px solid #2e2e2e;
    border-radius: 4px;
    padding: 4px 7px;
    font-size: 11px;
}
